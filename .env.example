# Neon Postgres connection string (Vercel → Storage → Neon). Leave empty locally
# to use the embedded PGlite database in ./.data.
DATABASE_URL=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that are approved admins from their first sign-in
ADMIN_EMAILS=
ALLOWED_EMAIL_DOMAIN=seecs.edu.pk

# Local only: email-only login without Google. Never enable in production.
DEV_LOGIN=
NEXT_PUBLIC_DEV_LOGIN=
